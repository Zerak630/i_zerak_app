# A deposer dans /etc/sudoers.d/izerak-agent, en chmod 440, apres validation
# par `visudo -c -f`.
#
# Une entree par couple action/unite plutot qu'un caractere generique : c'est
# verbeux, mais cela rend l'autorisation lisible et auditable, et empeche
# l'agent d'agir sur une unite qui ne figure pas ici meme en cas de faille dans
# sa validation.

izerak-agent ALL=(root) NOPASSWD: /bin/systemctl start emby-server.service
izerak-agent ALL=(root) NOPASSWD: /bin/systemctl stop emby-server.service
izerak-agent ALL=(root) NOPASSWD: /bin/systemctl restart emby-server.service

izerak-agent ALL=(root) NOPASSWD: /bin/systemctl start qbittorrent-nox.service
izerak-agent ALL=(root) NOPASSWD: /bin/systemctl stop qbittorrent-nox.service
izerak-agent ALL=(root) NOPASSWD: /bin/systemctl restart qbittorrent-nox.service

izerak-agent ALL=(root) NOPASSWD: /bin/systemctl start syncthing@pi.service
izerak-agent ALL=(root) NOPASSWD: /bin/systemctl stop syncthing@pi.service
izerak-agent ALL=(root) NOPASSWD: /bin/systemctl restart syncthing@pi.service
