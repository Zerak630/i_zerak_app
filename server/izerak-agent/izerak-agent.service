[Unit]
Description=Agent de supervision iZerak
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=izerak-agent
Group=izerak-agent
Environment=IZERAK_AGENT_CONFIG=/etc/izerak-agent/config.yaml
ExecStart=/opt/izerak-agent/venv/bin/python -m izerak_agent.main
WorkingDirectory=/opt/izerak-agent
Restart=on-failure
RestartSec=5

# Durcissement. NoNewPrivileges doit rester a « no » : il empeche sudo de
# prendre l'uid root, et toute action sur un service echoue alors en 502
# (« sudo: le uid effectif n'est pas 0 »).
#
# Il ne suffit pas de l'omettre. Pour un compte non root, systemd l'active
# implicitement des qu'une option reposant sur seccomp ou sur le noyau est
# presente : RestrictAddressFamilies, RestrictNamespaces, LockPersonality,
# MemoryDenyWriteExecute, ProtectKernelTunables, ProtectKernelModules,
# SystemCallFilter, PrivateDevices, RestrictSUIDSGID... Aucune ne doit figurer
# ici. Verification apres installation :
#
#   grep NoNewPrivs /proc/$(systemctl show izerak-agent -p MainPID --value)/status
#
# qui doit afficher 0. Les restrictions de systeme de fichiers ci-dessous n'ont
# pas cet effet.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/izerak-agent

[Install]
WantedBy=multi-user.target
