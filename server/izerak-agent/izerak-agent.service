[Unit]
Description=Agent de supervision iZerak
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=izerak-agent
Group=izerak-agent
Environment=IZERAK_AGENT_CONFIG=/etc/izerak-agent/config.yaml
ExecStart=/opt/izerak-agent/venv/bin/python -m izerak_agent.main
WorkingDirectory=/opt/izerak-agent
Restart=on-failure
RestartSec=5

# Durcissement. NoNewPrivileges est volontairement absent : il empecherait
# l'elevation par sudo dont l'agent a besoin pour piloter systemctl. Les autres
# restrictions compensent en limitant ce qui reste accessible au processus.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/etc/izerak-agent

[Install]
WantedBy=multi-user.target
