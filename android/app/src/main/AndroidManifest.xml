<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Onglet Temps libre. L'acces aux donnees d'utilisation ne s'accorde
         pas par une boite de dialogue : l'utilisateur l'active lui-meme dans
         les reglages, d'ou le tools:ignore. Les trois autres servent au bilan
         du soir : l'afficher, et le reprogrammer apres un redemarrage. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Synchronisation par le dossier Syncthing. Depuis Android 11, lire un
         fichier qu'une autre application a depose dans le stockage partage
         demande l'acces a tous les fichiers : c'est ce que fait Obsidian pour
         son coffre. L'application n'est pas destinee au Play Store, dont la
         politique encadre cette permission. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
    <!-- Android 10 et moins ignorent la permission ci-dessus : les deux
         permissions classiques y suffisent. Au-dela, elles n'accordent plus
         rien pour des fichiers qui ne sont pas des medias. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage"/>

    <!-- requestLegacyExternalStorage : sous Android 10, le stockage cloisonne
         s'applique deja, et seul ce drapeau rend au chemin brut du dossier
         partage son sens. Ignore a partir d'Android 11. -->
    <application
        android:requestLegacyExternalStorage="true"
        android:label="iZerak"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Bilan du soir de l'onglet Temps libre (cf. DailyReport.kt). Non
             exporte : seuls l'alarme d'iZerak et le systeme le reveillent. -->
        <receiver
            android:name=".DailyReportReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Widgets de l'ecran d'accueil (cf. HomeWidgets.kt). -->
        <receiver
            android:name=".CommuteWidgetProvider"
            android:exported="false"
            android:label="@string/widget_commute_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_commute_info" />
        </receiver>
        <receiver
            android:name=".FreeTimeWidgetProvider"
            android:exported="false"
            android:label="@string/widget_free_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_free_time_info" />
        </receiver>
        <receiver
            android:name=".GoalWidgetProvider"
            android:exported="false"
            android:label="@string/widget_goal_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_goal_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Depuis Android 11, une application ne voit que les applications
         qu'elle declare ici : sans cette section, canLaunchUrl repond false
         pour google.navigation: et geo:, et le bouton « Y aller » resterait
         inerte sans le moindre message. Le repli https reste couvert par
         l'entree VIEW / https. -->
    <queries>
        <!-- Liste des applications a suivre dans l'onglet Temps libre : celles
             qui ont une icone dans le lanceur. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Bouton « Ouvrir » des services du Pi : leurs interfaces web sont
             souvent en http simple sur le reseau local (Cora, port 5000). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
