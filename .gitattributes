# Normalisation des fins de ligne.
#
# Sans ces regles, un poste Windows avec core.autocrlf=true recupere ces
# fichiers en CRLF. Deployes tels quels sur le Raspberry Pi, ils echouent :
# un script shell leve « bad interpreter: /bin/bash^M », une unite systemd et
# une regle sudoers deviennent invalides.

* text=auto

# Consommes par Linux : toujours en LF, quel que soit le poste.
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.sudoers   text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
gradlew     text eol=lf

# Consommes par Windows : toujours en CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binaires : aucune conversion.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.jar       binary
*.keystore  binary
*.apk       binary
